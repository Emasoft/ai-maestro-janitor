# Build artifacts and caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Node / npm
node_modules/
.npm/

# Secrets and local config
.env
.env.local
.env.*.local
*.pem
*.key

# Claude Code cache directory — ignore the whole tree DEEPLY (`**`, not a bare
# `.claude/`). The bare form prunes the directory so git never descends to honor
# a re-include; `.claude/**` lets the exceptions below take effect.
.claude/**
# …but the PROJECT memory scope lives in-repo under .claude/ and MUST be tracked
# + pushed (it is the shared, cross-dev memory). Re-include it via these
# exceptions (each parent dir is re-included first, then the whole tree).
!.claude/project/
!.claude/project/memory/
!.claude/project/memory/**

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Plugin runtime state (per-project, not tracked)
.janitor/
.rechecker/

# Test and coverage artifacts
.coverage
htmlcov/
.pytest_cache/
*.log

# Distribution packages
*.tar.gz
*.zip
*.whl

# Dev-only directories (local reports, scratch, validation output).
# Per ~/.claude/CLAUDE.md RULE 0.2, every `*_dev/` folder at the
# project root is gitignored AND its content must never be deleted.
docs_dev/
scripts_dev/
samples_dev/
examples_dev/
tests_dev/
downloads_dev/
libs_dev/
builds_dev/
reports_dev/
.tldr/
.tldrignore
llm_externalizer_output/
/reports/
/INPUT_DEV/

# git-cliff scratch — ephemeral release notes between bump and push
.git-cliff-release-notes.md
/reports_dev/
/.trashcan/*
!/.trashcan/.gitkeep
!/.trashcan/README.txt

# Added by CPV standardize
*_dev/
.ruff_cache/
