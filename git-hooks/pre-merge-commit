#!/usr/bin/env bash
# pre-merge-commit hook — secret scan of the merged index (TRDD-FNPDFZWU increment 1).
# `git merge --no-ff` runs pre-merge-commit and commit-msg but NOT pre-commit (measured 2026-11-18),
# so a side branch could bring a secret into the merge commit unscanned. This runs the same index scan
# as pre-commit stage 0b and fails closed the same way (exit 2 from the scanner blocks too).
# Inert (exit 0) when the janitor is not active: see scripts/lib/staged_secret_scan.py.
# THIS FILE IS THE SOURCE — publish.py::install_hook copies it to .git/hooks/pre-merge-commit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
uv run python scripts/lib/staged_secret_scan.py || {
  echo "pre-merge-commit: secret scan blocked the merge commit (see output above)."
  exit 1
}
