#!/usr/bin/env sh
# Pre-push hook — branch-aware gate (see gen_pre_push_hook docstring).
#   * default branch (main/master) or any tag -> full publish.py --gate
#     (release gate: publish.py process ancestry + lint/validate/tests)
#   * any other (feature) branch -> allowed, but ONLY after a passing
#     secret scan of the pushed commits (trufflehog). trufflehog absent =>
#     FAIL CLOSED (an unscanned push is never silently allowed).
# POSIX sh, fail-fast, single code path.
#
# THIS FILE IS THE SOURCE — edit it here. It said "Auto-generated by
# scripts/publish.py's generator — do NOT edit by hand; the pipeline rewrites it
# from the template" until 2026-09-04, and that was false: no generator exists.
# `publish.py::install_hook` COPIES this file to `.git/hooks/pre-push` and sets
# `core.hooksPath` ("Copy git-hooks/pre-push to .git/hooks/pre-push"), and no
# code anywhere emits this text. The stale warning had teeth — it tells a reader
# that any fix here will be overwritten, which is exactly the belief that leaves
# a bug unfixed. TRDD-CN62E66F.
#
# WHICH FILE RUNS depends on `core.hooksPath`, and `install_hook` sets up BOTH
# paths deliberately — it copies this file to `.git/hooks/pre-push` AND sets
# `core.hooksPath = git-hooks`:
#   * with `core.hooksPath` set (git >= 2.9, the normal case here) git executes
#     THIS FILE directly, so an edit is live immediately, no install step;
#   * on git < 2.9 the key is IGNORED SILENTLY, and on any clone where it is
#     unset or overridden, the `.git/hooks/` copy is what runs.
# So the copy is a fallback, not dead weight, and re-running `--install-hook`
# after an edit still matters for those cases.
#
# Two earlier versions of this note were each wrong in one direction: the first
# said "auto-generated, do NOT edit by hand" (there is no generator), the second
# said the copy "is never run" (true only for git >= 2.9 with the config intact).
set -u

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

ZERO=0000000000000000000000000000000000000000

# Default branch name from origin/HEAD (e.g. "main"/"master"), or empty.
default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"

# Full release gate: only publish.py may push the default branch / tags.
run_release_gate() {
    if command -v uv >/dev/null 2>&1; then
        uv run python scripts/publish.py --gate
        return $?
    fi
    # NO uv: `python3` is whatever is first on PATH and is NOT checked against
    # pyproject's `requires-python` the way `uv run` is. publish.py imports
    # `typing.assert_never` at module scope (3.11+), so a sub-3.11 interpreter
    # dies with `ImportError: cannot import name 'assert_never'` -- a diagnostic
    # that names a typing symbol and tells the operator nothing about why their
    # push was blocked. This gate also runs on ordinary ref DELETIONS (see the
    # dispatch below: a deletion sets neither flag, so `saw_feature -eq 0` fires
    # it), which is routine cleanup, so the bad message would surface on a
    # common operation unrelated to releasing. TRDD-CN62E66F.
    #
    # The floor is pyproject's `requires-python`; keep the two in step.
    # ABSENT and TOO-OLD are different failures and must not share a message.
    # `python3 -c ...` exits 127 when there is no python3 at all, which `!` turns
    # into the same branch as a 3.10 interpreter — so a single message would tell
    # an operator with NO python3 that theirs is "older than 3.11". A refusal that
    # misdescribes the cause is barely better than the ImportError it replaced.
    if ! command -v python3 >/dev/null 2>&1; then
        echo "pre-push: refusing to run the release gate." >&2
        echo "  Neither \`uv\` nor \`python3\` is on PATH, and the gate needs one of them." >&2
        echo "  Install uv (https://docs.astral.sh/uv/) — it is the supported path." >&2
        return 1
    fi
    if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
        echo "pre-push: refusing to run the release gate." >&2
        # "or could not be run" is load-bearing, not hedging: `command -v` proves a
        # file is FINDABLE, never that it EXECUTES. A dead shebang, a permission
        # problem, or a half-installed pyenv shim all reach here, and without this
        # clause the refusal would state a version fact it has not established —
        # the same defect as the message it replaced.
        echo "  \`uv\` is not installed, and \`python3\` on PATH is older than 3.11 or could not be run (pyproject.toml: requires-python >=3.11)." >&2
        echo "  Install uv (https://docs.astral.sh/uv/) or put a working >=3.11 python3 on PATH." >&2
        return 1
    fi
    python3 scripts/publish.py --gate
}

# Secret-scan ONLY the new commits of a feature-branch push.
#   $1 local sha   $2 remote sha   $3 short branch name
# Returns 0 (clean -> allow) or non-zero (secret found / cannot scan -> block).
secret_scan_range() {
    if ! command -v trufflehog >/dev/null 2>&1; then
        echo "BLOCKED: trufflehog is not installed — a feature-branch push must be" >&2
        echo "         secret-scanned first. Install trufflehog" >&2
        echo "         (https://github.com/trufflesecurity/trufflehog)" >&2
        echo "         or push through scripts/publish.py." >&2
        return 1
    fi
    # Scan from the commit already on the remote (nothing new before it). For a
    # brand-new branch (remote side all-zeros) start from the default branch tip
    # so inherited history is not re-scanned; if none resolves, scan the whole
    # branch (a fresh repo has no inherited content to false-positive on).
    base=""
    if [ "$2" != "$ZERO" ]; then
        base="$2"
    elif [ -n "$default_branch" ]; then
        base="$(git rev-parse --verify --quiet "origin/$default_branch" 2>/dev/null              || git rev-parse --verify --quiet "$default_branch" 2>/dev/null || true)"
    fi
    if [ -n "$base" ]; then
        trufflehog git "file://$REPO_ROOT" --since-commit "$base" --branch "$3" --no-update --fail
    else
        trufflehog git "file://$REPO_ROOT" --branch "$3" --no-update --fail
    fi
}

release_push=0
saw_feature=0
scan_failed=0

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
while read -r localref localsha remoteref remotesha; do
    [ -z "$localref" ] && continue
    [ "$localsha" = "$ZERO" ] && continue    # ref deletion — nothing to gate/scan
    case "$remoteref" in
        refs/tags/*|refs/heads/main|refs/heads/master)
            release_push=1
            ;;
        refs/heads/*)
            short=${remoteref#refs/heads/}
            if [ -n "$default_branch" ] && [ "$short" = "$default_branch" ]; then
                release_push=1
            else
                saw_feature=1
                secret_scan_range "$localsha" "$remotesha" "$short" || scan_failed=1
            fi
            ;;
        *)
            release_push=1    # unknown ref shape — gate conservatively
            ;;
    esac
done

# A release ref is present, or nothing parsed -> enforce the full release gate.
if [ "$release_push" -eq 1 ] || [ "$saw_feature" -eq 0 ]; then
    run_release_gate
    exit $?
fi

# Feature-branch-only push: allowed iff every secret scan passed.
if [ "$scan_failed" -eq 1 ]; then
    echo "BLOCKED: secret scan failed for a feature-branch push (see above)." >&2
    exit 1
fi
exit 0
