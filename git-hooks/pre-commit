#!/usr/bin/env bash
# Pre-commit hook — four stages (0 = reports/ redaction, then 1-3 below):
#   1. Privacy-leak scan (TRDD-FWDZDB7W): the staged diff is scanned for
#      personal e-mails, home paths, machine identity and PII shapes by
#      scripts/lib/staged_privacy_scan.py (reuses the G1b lint and the
#      private_path_patterns / privacy_patterns libraries). Any hit BLOCKS
#      the commit with a MASKED value; a scanner failure also blocks —
#      no silent bypass. Values the file already holds at HEAD are not
#      re-flagged, so editing an owner-accepted card is not re-blocked.
#   2. Executable-bit check (TRDD-3JBPW12E): refuses a commit that would
#      drop a tracked script's executable bit. A fastedit/Write rewrite
#      recreates a file at mode 644; tests/test_detector_executable_bits.py
#      detects this from the git index in 0.2s.
#
#   3. Bug scan (advisory on findings, blocking on silence): `ubs --staged`
#      scans the staged set and reports per-severity counts. Findings never
#      block; a scanner that did not RUN (absent, exit 2, unrecognized code,
#      unparseable report) BLOCKS, matching Stage 1's "no silent bypass".
# THIS FILE IS THE SOURCE — edit it here. `publish.py::install_hook` copies
# it to .git/hooks/pre-commit and points core.hooksPath at the `git-hooks`
# directory — an ABSOLUTE path in a working clone (verified 2026-11-09:
# core.hooksPath=/Volumes/EmaUITEK4TBSSD/Code/AI-MAESTRO-JANITOR/ai-maestro-janitor/git-hooks),
# NOT the relative `git-hooks` this comment claimed until 2026-11-09.
# git-hooks/pre-push for the sibling hook this mirrors).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Stage 0 — redact the staged files under reports/ BEFORE anything scans them
# (TRDD-KSUIEPTQ). OWNER ORDER 2026-11-14: "reports must be git tracked! ends of
# the story! this is why we implemented the secret redactor in the first place,
# so it is always run before committing, redacting all secrets in the new files
# under reports/". The helper runs `sanitize-reports` on every staged
# added/modified file under the root reports/ and re-stages the result, so
# Stage 1 and the commit see redacted content. It fails closed (sanitize-reports
# missing, unstaged hunks in a reports/ file, sanitize failure): no fallback, no
# skip. Nothing staged under reports/ => silent exit 0.
uv run python scripts/lib/redact_staged_reports.py || {
  echo "pre-commit: reports/ redaction blocked the commit (see output above)."
  exit 1
}

# Stage 1 — staged-diff privacy scan. Fail toward BLOCKING: exit 2 from the
# scanner (git failure, no toplevel) blocks the commit too, never waves it
# through with a warning.
uv run python scripts/lib/staged_privacy_scan.py || {
  echo "pre-commit: privacy scan blocked the commit (see BLOCKED output above)."
  exit 1
}

# Stage 2 — capture output (instead of letting pytest stream straight to the
# terminal) so the failure message below can tell an exec-bit violation
# apart from an unrelated pytest failure. WHY: on 2026-09-24 a concurrent
# worker edited a tracked file mid-run, tripping the suite's real-state
# write guard ("REAL-STATE WRITE GUARD FAILED … CHANGED: ...") — a failure
# that has nothing to do with permission bits — and the old hook printed
# the exec-bit remedy regardless of cause, which was simply wrong; a retry
# passed. Never claim a specific cause the exit code alone can't prove.
pytest_output="$(uv run pytest -q -p no:cacheprovider tests/test_detector_executable_bits.py 2>&1)" || {
    echo "$pytest_output"
    if grep -q "REAL-STATE WRITE GUARD FAILED" <<<"$pytest_output"; then
      echo "pre-commit: test_detector_executable_bits.py failed — its real-state write guard tripped (see output above), meaning a tracked file was edited mid-run by another process. Re-run the commit; if it keeps failing, check for a lost executable bit: chmod 755 <file> && git add <file>."
    else
      echo "pre-commit: test_detector_executable_bits.py failed (see output above) — either a tracked script lost its executable bit (chmod 755 <file> && git add <file>) or the run was disturbed by a concurrent process (re-run the commit)."
    fi
    exit 1
  }

# Stage 3 — bug scan (ultimate-bug-scanner / `ubs`). ADVISORY ON FINDINGS,
# BLOCKING ON SILENCE. Findings never block the commit; a scanner that did not
# actually RUN does, matching Stage 1's "no silent bypass".
#
# WHY FINDINGS NEVER BLOCK (advisory): ubs reports findings per RULE, with its
# samples[] array capped (measured 2026-11-09: one rule count=26, samples=3), so
# there is no stable per-instance identity to diff against. Count comparison
# misses remove-one/add-one of the same rule; line/code keys block ordinary
# edits (line drift) and renames. Blocking on ANY finding is unusable too: 73
# criticals + 300 warnings already exist at HEAD (a policy judgment on a
# measured count, not itself a measurement).
#
# WHY A `|| ubs_rc=$?` AND NOT `|| true`: `ubs --staged` EXITS 1 WHEN IT FINDS
# A CRITICAL (measured). Without the capture this advisory becomes a blocking
# gate on the first staged critical; with `|| true` the real code is clobbered
# to 0 and the case below reports a false clean. Removing this is a regression.
#
# WHY rc=0 IS NOT "CLEAN" (measured 2026-11-09): rc=1 requires >=1 CRITICAL —
# WARNINGS ALONE RETURN 0. So rc=0 can carry warnings, and the counts below are
# read from the JSON report, not inferred from the exit code.
# COUNTS COME FROM A TMP REPORT, NOT A PIPE: ubs writes a banner BEFORE its
# JSON, so the report is read from a file and parsed after the first `{`.
# Stdlib python3 only (no uv, no venv, no project file needed). A parsed object
# WITHOUT both `totals` and `scanners` is refused, never defaulted to zeros: a
# wrong-brace parse would otherwise print "0 0 0" — a confident FALSE CLEAN,
# the very bug this stage exists to prevent.
# The report path is `mktemp .../ubs-commit-XXXXXX` with NO suffix — BSD
# `mktemp` substitutes only trailing X's, so a `.json` template fails there.
# If mktemp itself fails (full temp dir) the scanner STILL runs, just without a
# report: an unrelated environmental failure must not block a commit.
# Non-code staged sets exit 3 with "no supported languages detected"; that
# message is the explanation, so it is printed in full rather than truncated.
#
# Deliberately NOT set: UBS_ALLOW_NO_SCAN (measured: it turns exit 3 into 0).
ubs_rc=0
ubs_report="$(mktemp "${TMPDIR:-/tmp}/ubs-commit-XXXXXX" 2>/dev/null)" || ubs_report=""
if [ -n "$ubs_report" ]; then
  ubs_text="$(ubs --staged --format=json --report-json="$ubs_report" 2>&1)" || ubs_rc=$?
else
  # mktemp failed (e.g. a full temp dir). Still RUN the scanner, just without a
  # report — counts are then unavailable. Deliberately NOT a block: a full temp
  # dir is not the committer's fault, and blocking there would punish an
  # unrelated condition. The scan still runs and its text still prints.
  ubs_text="$(ubs --staged 2>&1)" || ubs_rc=$?
fi

ubs_summary=""
ubs_findings=""
if [ -n "$ubs_report" ]; then
  ubs_parsed="$(UBS_REPORT="$ubs_report" python3 - <<'PY' 2>/dev/null || true
import json, os
raw = open(os.environ["UBS_REPORT"], encoding="utf-8", errors="replace").read()
i = raw.find("{")
if i < 0:
    raise SystemExit(1)
d = json.loads(raw[i:])
# BOTH keys are required. A well-formed JSON object that lacks them is NOT a
# ubs report — a wrong-brace parse or a schema change. Defaulting to zeros
# there would print a confident "0 0 0" false clean, which is the exact bug
# this stage exists to prevent, so refuse the report instead.
if "totals" not in d or "scanners" not in d:
    raise SystemExit(1)
t = d["totals"]
print(f'{int(t.get("critical", 0))} {int(t.get("warning", 0))} {int(t.get("info", 0))}')
for sc in d.get("scanners", []):
    for f in sc.get("findings", []):
        if f.get("severity") in ("critical", "warning") and f.get("count"):
            for smp in f.get("samples", [])[:3]:
                loc = str(smp.get("file", "?"))
                if smp.get("line"):
                    loc += f':{smp["line"]}'
                print(f'  {f["severity"]} {f.get("rule_id", "?")} {loc}')
PY
)"
  ubs_counts="$(printf '%s\n' "$ubs_parsed" | head -1)"
  ubs_findings="$(printf '%s\n' "$ubs_parsed" | tail -n +2)"
  # Validate the counts line is EXACTLY three fields before trusting it: a
  # schema change that adds or drops a severity must not be read as "0 0 0".
  read -r ubs_crit ubs_warn ubs_info ubs_extra <<<"$ubs_counts"
  if [ -z "${ubs_crit:-}" ] || [ -z "${ubs_warn:-}" ] || [ -z "${ubs_info:-}" ] || [ -n "${ubs_extra:-}" ]; then
    ubs_counts=""
    ubs_findings=""
  else
    ubs_summary="critical $ubs_crit, warning $ubs_warn, info $ubs_info"
  fi
fi

case "$ubs_rc" in
  0|1)
    if [ -z "$ubs_report" ]; then
      printf '%s\n' "$ubs_text"
      echo "pre-commit: ubs — ran, but no report could be created (temp-file failure), so counts are unavailable. Findings above are ADVISORY; nothing blocked. [advisory stage]"
    elif [ -n "$ubs_summary" ]; then
      if [ -n "$ubs_findings" ]; then
        echo "pre-commit: ubs — up to 3 sample locations per rule; the counts are RULE GROUPS, not finding instances:"
        printf '%s\n' "$ubs_findings"
      fi
      if [ "$ubs_crit" -eq 0 ]; then
        rm -f "$ubs_report"
        echo "pre-commit: ubs — no critical findings in the staged set ($ubs_summary). [advisory stage]"
      else
        echo "pre-commit: ubs — CRITICAL findings in the staged set ($ubs_summary). ADVISORY: they did NOT block this commit. Full report kept at: $ubs_report"
      fi
    elif [ ! -s "$ubs_report" ]; then
      # MEASURED 2026-11-09: for an EMPTY staged set ubs exits 0 and writes NO
      # report — the mktemp file stays 0 bytes. An empty report file is a
      # MACHINE-CHECKABLE "nothing to scan", so the decision does not depend on
      # matching ubs' English message, which a reword would break in the worst
      # direction (blocking every no-op commit).
      rm -f "$ubs_report"
      echo "pre-commit: ubs — nothing staged to scan (ubs wrote no report: no changed files). [advisory stage]"
    else
      printf '%s\n' "$ubs_text"
      rm -f "$ubs_report"
      echo "pre-commit: ubs reported exit $ubs_rc but wrote no parsable ubs report (output above) — the result is unknown. BLOCKING, because an unreadable result is not a clean one."
      exit 1
    fi
    ;;
  3)
    printf '%s\n' "$ubs_text"
    rm -f "$ubs_report"
    echo "pre-commit: ubs — scanned nothing (exit 3, above: no supported source file in the staged set). Not a pass, not a failure; not blocked. [advisory stage]"
    ;;
  *)
    printf '%s\n' "$ubs_text"
    rm -f "$ubs_report"
    echo "pre-commit: ubs — exit $ubs_rc, which this hook does not recognise as a scan result (output above). BLOCKING to fail safe; if the code is new, update this hook."
    echo "  fix: ubs doctor --fix   (needs ast-grep, ripgrep, jq, typos-cli, typos-lsp; see the ultimate-bug-scanner skill for install lines per platform)."
    echo "  if this is an environment problem you cannot fix now: git commit --no-verify"
    exit 1
    ;;
esac
#
